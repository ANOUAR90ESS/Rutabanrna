# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: TMB iTransit real-time predictions (https://developer.tmb.cat).
# Without them the app uses the official GTFS timetable (public/data/tmb-network.json).
# Production (recommended): keys stay on the server (server/index.mjs, `npm start`).
TMB_APP_ID=""
TMB_APP_KEY=""
VITE_TMB_PROXY_URL="/api/tmb"
# Development only — VITE_ variables are embedded in the public JavaScript bundle:
# VITE_TMB_APP_ID=""
# VITE_TMB_APP_KEY=""

# Optional: own geocoder instances for address search (defaults: public Photon / Nominatim, OpenStreetMap data).
VITE_PHOTON_URL=""
VITE_NOMINATIM_URL=""
